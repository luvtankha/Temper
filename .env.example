SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
TEMPER_DEMO_ENABLED=true
TEMPER_CONTEXT_PREVIOUS_TURNS=5
# Optional pinned local foundation classifier; absent keeps chat running and diagnostic returns503.
# TEMPER_FOUNDATION_MODEL_DIR=C:/path/to/temper-model-cache/foundation-distilbert

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cerebro
DB_USERNAME=cerebro
DB_PASSWORD=change_me

VITE_API_BASE_URL=/api/v1
# local (default), rest or backend (live STOMP); backend storage/analysis provenance stays explicit.
VITE_CHAT_TRANSPORT=local
# Omit for same-origin websocket proxy; explicit values use ws:// or wss://.
# VITE_WS_URL=ws://localhost:8080/ws
TEMPER_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides for included Phase 04 runtime rigs.
# Defaults use the original rigs included with the application.
# VITE_MALE_RIG_URL=/avatars/male.riv
# VITE_FEMALE_RIG_URL=/avatars/female.riv

REDIS_HOST=localhost
REDIS_PORT=6379
