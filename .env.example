SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
TEMPER_DEMO_ENABLED=true
TEMPER_CONTEXT_PREVIOUS_TURNS=5
# Optional pinned local foundation classifier; absent keeps chat running and diagnostic returns503.
# TEMPER_FOUNDATION_MODEL_DIR=C:/path/to/temper-model-cache/foundation-distilbert
# Optional verified local RoBERTa. Absence leaves explicit MOCK conversation analysis.
# TEMPER_SENTIMENT_MODEL_DIR=C:/path/to/temper-model-cache/sentiment-roberta
# Optional dedicated MIT GoEmotions model; absence retains fixture emotion channels.
# TEMPER_EMOTION_MODEL_DIR=C:/path/to/temper-model-cache/emotion-goemotions
# Optional independent sarcasm classifier (Apache-2.0).
# TEMPER_SARCASM_MODEL_DIR=C:/path/to/temper-model-cache/sarcasm-bert

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cerebro
DB_USERNAME=cerebro
DB_PASSWORD=change_me

VITE_API_BASE_URL=/api/v1
# local (default), rest or backend (live STOMP); backend storage/analysis provenance stays explicit.
VITE_CHAT_TRANSPORT=local
# Omit for same-origin websocket proxy; explicit values use ws:// or wss://.
# VITE_WS_URL=ws://localhost:8080/ws
TEMPER_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides for included Phase 04 runtime rigs.
# Defaults use the original rigs included with the application.
# VITE_MALE_RIG_URL=/avatars/male.riv
# VITE_FEMALE_RIG_URL=/avatars/female.riv

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional pinned local toxicity model (download with scripts/download-toxicity.ps1)
# TEMPER_TOXICITY_MODEL_DIR=C:/Users/Admin/.codex/cache/temper-models/toxicity-bert

# Estimated lexical/context indicators; false preserves model-free fixture demonstration.
TEMPER_INDICATORS_ENABLED=true

# Conflict engineering weights must sum to1.
TEMPER_CONFLICT_WEIGHTS=negativeSentiment=0.25,anger=0.20,toxicity=0.20,sarcasm=0.15,blame=0.10,defensiveness=0.10
TEMPER_CONFLICT_SMOOTHING=0.6,0.3,0.1
TEMPER_CONFLICT_TREND_THRESHOLD=0.08
