TEMPER_STORE_ENABLED=true
TEMPER_DEMO_ENABLED=false
# Google Play licensing public key from this app's Play Console entry (Base64 DER).
TEMPER_PLAY_LICENSE_KEY=
# Mount service-account JSON and a distinct PKCS8 RSA signing key from a secret manager.
TEMPER_PLAY_CREDENTIALS=/secrets/google-play.json
TEMPER_STORE_SIGNING_KEY=/secrets/entitlements.pem
SERVER_PORT=8080
# The platform terminates HTTPS. Do not expose this container over public HTTP.
