# Deploy separately from purchases, behind HTTPS. Mount a private persistent volume.
TEMPER_LEARNING_ENABLED=true
TEMPER_STORE_ENABLED=false
TEMPER_DEMO_ENABLED=false
TEMPER_LEARNING_DIRECTORY=/data/feedback
# Secret file containing Base64 of 32 securely generated random bytes. Never commit it.
TEMPER_LEARNING_KEY_FILE=/run/secrets/feedback-storage-key
SERVER_PORT=8080
