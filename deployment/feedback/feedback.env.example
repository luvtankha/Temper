# Single Linux VPS only. Copy outside the repository to /etc/temper-feedback.env.
# Empty values deliberately prevent bootstrap/deployment. Do not use an example domain.
FEEDBACK_DOMAIN=
ACME_EMAIL=
# Review the current official Caddy release and record its linux-compatible immutable digest:
# caddy:2@sha256:<64 lowercase hex characters>
CADDY_IMAGE=
# This path is fixed by the bootstrap so private data cannot accidentally target arbitrary paths.
FEEDBACK_ROOT=/srv/temper-feedback
